#!/usr/bin/env bash
#
# Gradescope entry point.  Every autograder file is included in the autograder
# zip, which Gradescope extracts into /autograder/source, so nothing is fetched
# from GitHub.  This hands off to grade.sh, which does the grading.

BASE_DIR=/autograder/source
RESULTS_FILE=/autograder/results/results.json

# Shared feedback runs after functional grading, including its error paths.
append_ai_feedback() {
  local functional_status=$?
  python3 "$BASE_DIR/gradescope_feedback.py" || echo "AI feedback was unavailable; functional results are unchanged." >&2
  exit "$functional_status"
}
trap append_ai_feedback EXIT

cd "$BASE_DIR" || exit 1

if [ ! -f "$BASE_DIR/grade.sh" ]; then
  echo "ERROR: $BASE_DIR/grade.sh not found (was it included in the autograder zip?)."
  mkdir -p "$(dirname "$RESULTS_FILE")"
  printf '{"score": 0, "output": "The autograder is misconfigured. This is not your fault; please contact the instructor."}\n' > "$RESULTS_FILE"
  exit 0
fi

bash "$BASE_DIR/grade.sh"
