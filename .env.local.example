# Copy this file to .env.local. Never commit .env.local.
GRADING_API_URL=http://localhost:8000
INTEGRATION_API_TOKEN=local-development-token
GRADESCOPE_COURSE_ID=your-course-id
GRADESCOPE_USERNAME=your-non-sso-email
GRADESCOPE_PASSWORD=your-password
GRADESCOPE_STORAGE_STATE=.auth/gradescope.json
GRADESCOPE_ALLOW_RERUN=1
# Use AI_FAILURES for retry runs; use PENDING_NIGHTLY for the initial batch.
NIGHTLY_TRIGGER_SOURCE=AI_FAILURES
# Set HEADFUL=1 only when debugging locally.
HEADFUL=0
