@startuml 04-sequence-instructor
' =====================================================================
' Automated Code Feedback -- Instructor Configuration and Review
' Traces to: FR-1..FR-11, NFR-9, NFR-10, DR-1..DR-3
' =====================================================================

title Instructor Configuration and Review

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign left
skinparam maxMessageSize 200

actor Instructor as instr
participant "Web\nFrontend" as fe #DCEFD9
participant "Web Backend\n/ REST API" as be #DCEFD9
participant "Repository\nLayer" as repo #DCEFD9
database "Grading DB" as db #DCEFD9

== Configure an assignment [FR-1, FR-6] ==

instr -> fe : create assignment
fe -> be : POST /assignments\n{course_id, platform,\nplatform_assignment_id, name}
be -> repo : create_assignment()
repo -> db : INSERT assignment
db --> repo : assignment_id
be --> fe : 201 {assignment_id}

== Define grading targets [FR-2, FR-3, FR-7] ==

loop for each method / class to grade
  instr -> fe : add grading target\n(identifier, kind, max_score)
  fe -> be : POST /assignments/{id}/targets
  be -> repo : create_target()
  repo -> db : INSERT grading_target

  instr -> fe : designate relevant\nstudent files (globs)
  fe -> be : POST /targets/{id}/file-patterns
  be -> repo : set_file_patterns()
  repo -> db : INSERT target_file_pattern
end

== Attach rubric and feedback guidance [FR-4, FR-5, FR-13] ==

instr -> fe : write rubric criteria\n+ feedback guidance
fe -> be : PUT /targets/{id}/rubric
be -> repo : upsert_rubric()
repo -> db : INSERT rubric (version = n+1,\nis_current = true)
repo -> db : UPDATE prior rubric\nSET is_current = false

note right of repo #FFF8DC
  Rubrics are versioned, not overwritten.
  Feedback rows reference rubric_id, so
  feedback generated last week stays
  explainable after an edit this week.
end note

== Review results [FR-8, FR-9, FR-10, NFR-10] ==

instr -> fe : open results dashboard
fe -> be : GET /assignments/{id}/results\n?filter=has_deduction
be -> repo : list_results()
repo -> db : SELECT joining submission,\ntest_outcome, feedback\nWHERE has_deduction
db --> repo : result rows
repo --> be : ResultSummary[]
be --> fe : 200 {results}
fe --> instr : table of submissions\nneeding attention

instr -> fe : drill into one submission
fe -> be : GET /submissions/{id}
be -> repo : get_submission_detail()
repo -> db : SELECT outcomes, all feedback\nrows (all providers),\nfeedback_comparison
db --> repo : detail
be --> fe : 200 {detail}
fe --> instr : side-by-side provider\nfeedback + confidence\n[FR-27, NFR-12]

== Rate feedback quality [FR-11] ==

instr -> fe : rate this feedback\n(1-5 + comment)
fe -> be : POST /feedback/{id}/review
be -> repo : create_review()
repo -> db : INSERT feedback_review

note over instr, db #FFF8DC
  **Open decision (SRS section 10):**
  Can the instructor EDIT generated feedback
  before it reaches the student, or only rate it
  after delivery? The two answers imply different
  architectures. Editing before delivery requires
  an approval gate between FEEDBACK_GENERATED and
  DELIVERY_REQUESTED, which changes the state
  machine in 05 and blocks the nightly job on a
  human. Decide before Student B builds the
  dashboard.
end note

@enduml
