@startuml 04-sequence-nightly
' =====================================================================
' NIGHTLY targets: graded on a per-submission triggered rerun.
' Traces to: FR-29..FR-36, FR-41..FR-47, CI-3, CI-4
'
' Phase 1 is the same submission run as 03. The only difference is what
' the AI phase does with a task whose target is marked NIGHTLY: it
' leaves it alone. A submission with both kinds of target goes through
' both diagrams.
' =====================================================================

title NIGHTLY targets -- graded on a per-submission rerun

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220

actor Student as stud
participant "Scheduled\nWorkflow (cron)" as cron #EDE0F0
participant "Nightly Trigger\n(Playwright)" as trig #FBE6D4
participant "Gradescope" as gs #E8E8E8
box "Autograder Container" #F7F7F7
  participant "Autograder Script\n(run_autograder)" as script #FFF2CC
  participant "Instructor\nTest Suite" as ti #FFF2CC
  participant "Reporting\nLibrary" as wrap #FBE6D4
  participant "AI Grading\nPhase" as aip #D6E4F0
end box
participant "Web API" as api #DCEFD9
database "Grading DB" as db #DCEFD9
participant "LLM\nProviders" as llm #E8E8E8

== Phase 1: on submission -- mark the work, grade nothing ==

stud -> gs : submit code
gs -> script : run_autograder
script -> ti : run the test suite

loop for each test
  ti -> wrap : record_outcome(target, ...)
  wrap -> api : POST /outcomes
  api -> db : upsert submission,\ninsert test_outcome
end

opt her marking logic requests feedback
  ti -> wrap : request_ai_feedback(target)
  wrap -> api : POST /ai-requests
  api -> db : record the request
end

ti --> script : suite exits
script -> aip : invoke AI phase
aip -> api : POST /submissions/{id}/resolve-marks
api -> db : resolve ai_needed per target,\ninsert grading_task rows
api --> aip : 200 {tasks[], feedback_mode,\nai_graded_submitted_at}

note over aip #FFF8DC
  Every task here has feedback_mode = NIGHTLY,
  so the AI phase grades nothing and spends no
  tokens. The tasks stay NEEDED, so
  ai_graded_submitted_at stays NULL, which is
  what puts this submission in tonight's queue.
  No extra bookkeeping.
end note

aip -> aip : package results.json\n(test results only)
aip --> script : results.json
script -> gs : write results.json
gs --> stud : test results now,\nfeedback tomorrow

== Phase 2: nightly -- trigger a rerun per submission ==

cron -> trig : invoke
trig -> api : POST /trigger-runs (start)
trig -> api : GET /submissions/pending-ai
api -> db : SELECT submission JOIN grading_task\nWHERE ai_needed AND ai_status = 'PENDING'\nAND ai_graded_submitted_at IS NULL
db --> api : submission list
api --> trig : 200 {submissions[] with platform ids}

note right of api #FFF8DC
  The query does not mention feedback_mode. Any
  task still NEEDED qualifies, which means an
  IMMEDIATE target whose grading failed earlier
  is retried tonight for free. Its feedback
  arrives next morning rather than at once, a
  degradation worth documenting.
end note

trig -> gs : log in

loop for each submission needing AI grading
  trig -> gs : open the submission,\nclick "Rerun Autograder"
  gs --> trig : accepted
  trig -> api : POST /trigger-runs/{id}/record\n{platform_submission_id, ok}
end

note right of trig #FFF8DC
  Rerun is per submission, so the trigger only
  touches submissions that need work.

  Still the one fragile step: Gradescope has no
  public API, so locating a submission and
  clicking its rerun button is UI automation and
  will break when they reskin. Keep every
  selector in one file.

  Consider throttling the loop. A term's worth
  of submissions clicked as fast as Playwright
  manages looks like abuse from the outside.
end note

trig -> api : POST /trigger-runs/{id}/finish
api -> db : update trigger_run

== Phase 3: the rerun -- grade the NIGHTLY tasks ==

gs -> script : run_autograder again
script -> ti : the test suite runs again
loop for each test
  ti -> wrap : record_outcome(target, ...)
  wrap -> api : POST /outcomes
  api -> db : upsert, refresh test_outcome
end
ti --> script : suite exits

script -> aip : invoke AI phase
aip -> api : POST /submissions/{id}/resolve-marks
api --> aip : 200 {tasks[], feedback_mode,\nai_graded_submitted_at}

alt already fully graded (ai_graded_submitted_at = submitted_at)
  note right of aip #FFF8DC
    **The token guard.** Reruns happen for
    reasons other than our nightly job: an
    instructor debugging the autograder, a TA
    re-running a flaky test. None should re-bill
    the LLM.
  end note
  aip -> api : GET /submissions/{id}/feedback
  api --> aip : 200 {stored feedback}
  aip -> aip : package results.json\n(tests + stored feedback)

else work remains
  loop for each task with ai_needed and ai_status = PENDING
    aip -> api : GET /tasks/{id}/request
    api -> db : SELECT rubric, guidance,\ntest_outcome, submission_file
    api --> aip : 200 {FeedbackRequest}
    aip -> aip : build prompt

    group Multi-provider fan-out [FR-23, FR-27]
      par
        aip -> llm : Claude: generate
        llm --> aip : response
      else
        aip -> llm : ChatGPT: generate
        llm --> aip : response
      end
      aip -> aip : compare, estimate confidence
    end

    aip -> api : POST /tasks/{id}/feedback
    api -> db : insert feedback rows,\ninsert feedback_comparison,\nUPDATE ai_status = DONE
    api --> aip : 201
  end

  note right of aip #FFF8DC
    Tasks already DONE from an earlier IMMEDIATE
    pass are skipped by ai_status, so a
    mixed-mode submission does not pay twice for
    its IMMEDIATE targets.
  end note

  aip -> api : POST /submissions/{id}/ai-complete
  api -> db : UPDATE submission\nSET ai_graded_submitted_at = submitted_at\nWHERE NO task is still NEEDED\n(GAVE_UP counts as settled)
  api --> aip : 200 {guard_set}
  aip -> aip : package results.json\n(tests + all feedback)
end

aip --> script : results.json
script -> gs : write results.json
gs --> stud : feedback now visible

note over trig, db #FFF8DC
  **OQ-5, still open: failure policy.**
  1. A failed task stays NEEDED and increments
     attempt_count. The next night retries it
     while attempt_count < 3, then GAVE_UP.
  2. LLM calls retry with backoff on 429 and 5xx
     only, never on 400.
  3. If the trigger cannot find or click a
     submission's rerun button, record it on
     trigger_run and surface it. A silent trigger
     failure looks identical to "no feedback
     needed."
end note

@enduml
