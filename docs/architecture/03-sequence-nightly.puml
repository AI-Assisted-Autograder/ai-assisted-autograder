@startuml 03-sequence-nightly
' =====================================================================
' Automated Code Feedback -- Nightly Grading Run (end to end)
' Traces to: FR-19..FR-27, FR-29..FR-36, FR-41..FR-47, CI-3, CI-4
'
' This is the two-pass design. See DECISIONS.md for the alternatives
' that were considered and why this one was diagrammed.
' =====================================================================

title Nightly Grading Run -- Two-Pass Design

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220

participant "Scheduled\nWorkflow" as cron #EDE0F0
participant "Nightly\nOrchestrator" as orch #EDE0F0
participant "Gradescope\nAdapter" as adapter #FBE6D4
participant "Gradescope" as gs #E8E8E8
participant "Autograder\nClient" as agc #FBE6D4
participant "Web API" as api #DCEFD9
database "Grading DB" as db #DCEFD9
participant "Feedback\nEngine" as engine #D6E4F0
participant "LLM\nProviders" as llm #E8E8E8

== Pass 1: capture outcomes and code (runs on student submit) ==

note over agc
  Triggered by Gradescope when a student
  submits, NOT by our nightly job.
end note

agc -> agc : run instructor's\nfunctional tests
agc -> api : POST /submissions\n{platform_submission_id, student_id,\n outcomes[], source_files[]}
api -> db : upsert submission\nON CONFLICT (assignment_id,\nplatform_submission_id) DO NOTHING
api -> db : insert test_outcome rows
api -> db : set state = TESTS_RECORDED
api --> agc : 200 {submission_id,\nfeedback_available: false}
agc -> gs : write results.json\n(test results only, no feedback yet)

== Pass 2: nightly feedback generation ==

cron -> orch : invoke entrypoint (cron)
orch -> db : insert workflow_run (RUNNING)

group Discover work
  orch -> adapter : list_submissions(assignment, since)
  adapter -> gs : authenticate + scrape\nsubmission list
  gs --> adapter : submission refs
  adapter --> orch : SubmissionRef[]
  orch -> db : SELECT submissions\nWHERE state = 'TESTS_RECORDED'
  db --> orch : pending submissions
end

loop for each pending submission
  loop for each grading target
    orch -> db : load rubric, feedback_guidance,\ntest_outcome[], submission_file[]
    db --> orch : FeedbackRequest inputs
    orch -> engine : generate(FeedbackRequest)

    group Multi-provider fan-out [FR-23, FR-27]
      engine -> engine : build prompt\n(rubric + outcomes + code)
      par
        engine -> llm : Claude: generate_feedback()
        llm --> engine : text, suggested_score
      else
        engine -> llm : ChatGPT: generate_feedback()
        llm --> engine : text, suggested_score
      end
      engine -> engine : compare responses,\nestimate confidence
      engine -> db : insert feedback\n(one row per provider)
      engine -> db : insert feedback_comparison
      engine -> db : mark is_selected on\nchosen row
    end

    engine --> orch : ok
  end
  orch -> db : set state = FEEDBACK_GENERATED
end

== Pass 3: deliver feedback back to students ==

loop for each submission with feedback
  orch -> db : insert delivery (PENDING)
  orch -> adapter : trigger_regrade(submission_ref)
  adapter -> gs : browser-automate\n"Regrade Submission"
  note right of adapter #FFF8DC
    This is the fragile step. Gradescope
    has no public API, so this is UI
    scraping and WILL break when they
    reskin. Isolate it behind
    ILearningPlatform and keep the
    selectors in one file.
  end note

  gs -> agc : re-run autograder container
  agc -> api : GET /submissions/{id}/feedback
  api -> db : SELECT feedback\nWHERE is_selected = true
  db --> api : feedback rows
  api --> agc : 200 {feedback[], scores[]}
  agc -> agc : package results.json\n[FR-35]
  agc -> gs : write results.json\n(tests + LLM feedback)
  agc -> api : POST /deliveries/{id}/ack
  api -> db : delivery = SENT,\nstate = DELIVERED
end

orch -> db : update workflow_run\n(SUCCESS, counts)

note over orch, db #FFF8DC
  **Failure handling is undefined in the SRS
  (section 10) and must be specified before
  Student A and Student C write their retry
  code, or they will invent two different ones.**

  Minimum viable rule set to ratify:
  1. Any step failure sets state to the matching
     *_FAILED value and increments attempt_count.
  2. The orchestrator retries a submission on the
     next run while attempt_count < 3.
  3. LLM calls retry with backoff on 429 or 5xx
     only, never on a 400.
  4. A partially-graded submission is never
     delivered. All targets succeed, or none.
end note

@enduml
