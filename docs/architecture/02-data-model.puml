@startuml 02-data-model
' =====================================================================
' Automated Code Feedback -- Logical Data Model
' Traces to: FR-6, FR-12..FR-18, FR-25, FR-26, FR-28, FR-30, NFR-6
'
' Changes from the previous revision:
'   + assignment.grading_mode (IMMEDIATE | NIGHTLY)
'   + grading_task: the (submission x target) pair that carries the
'     "needs AI grading" mark the nightly rerun queries
'   - delivery: gone. Feedback is written to results.json in the same
'     autograder run that generates it, so there is no separate
'     delivery step to track.
' =====================================================================

title Logical Data Model

hide circle
' Do NOT add "hide methods" here. PlantUML treats any member containing
' parentheses as a method, which would hide the constraint lines.
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam linetype ortho

' ---------------------------------------------------------------------
' Instructor configuration
' ---------------------------------------------------------------------
entity "course" as course #DCEFD9 {
  * id : uuid <<PK>>
  --
  name : text
  term : text
}

entity "assignment" as assignment #DCEFD9 {
  * id : uuid <<PK>>
  --
  * course_id : uuid <<FK>>
  * platform : text <<GRADESCOPE>>
  * platform_assignment_id : text
  * grading_mode : text <<IMMEDIATE|NIGHTLY>>
  name : text
  is_active : boolean
  created_at : timestamptz
  --
  unique: platform, platform_assignment_id
  --
  grading_mode is the instructor's
  choice per assignment. It is read
  by the autograder script to decide
  whether to run AI grading inline,
  and by the nightly trigger to
  decide which assignments to rerun.
}

entity "grading_target" as target #DCEFD9 {
  * id : uuid <<PK>>
  --
  * assignment_id : uuid <<FK>>
  * identifier : text
  * kind : text <<METHOD|CLASS|FILE>>
  * needs_ai_grading : boolean
  max_score : numeric
  display_order : integer
  --
  FR-2, FR-3.
  needs_ai_grading is the instructor's
  static choice: does this target get
  AI feedback at all. Distinct from
  grading_task.ai_status, which is the
  per-submission runtime mark.
}

entity "target_file_pattern" as tfile #DCEFD9 {
  * id : uuid <<PK>>
  --
  * grading_target_id : uuid <<FK>>
  * path_glob : text
  --
  FR-7
}

entity "rubric" as rubric #DCEFD9 {
  * id : uuid <<PK>>
  --
  * grading_target_id : uuid <<FK>>
  * version : integer
  criteria_text : text
  feedback_guidance : text
  is_current : boolean
  created_at : timestamptz
  --
  FR-4, FR-5, FR-13.
  Versioned so feedback stays
  explainable after a rubric edit.
}

entity "llm_provider_config" as pcfg #DCEFD9 {
  * id : uuid <<PK>>
  --
  * provider : text <<ANTHROPIC|OPENAI|GOOGLE>>
  * model_name : text
  is_enabled : boolean
  is_primary : boolean
  --
  FR-23, NFR-11.
  Secrets live in the secret store,
  never in this table.
}

' ---------------------------------------------------------------------
' Runtime: written by the autograder script
' ---------------------------------------------------------------------
entity "submission" as sub #FBE6D4 {
  * id : uuid <<PK>>
  --
  * assignment_id : uuid <<FK>>
  * platform_submission_id : text
  student_identifier : text
  submitted_at : timestamptz
  is_active_attempt : boolean
  first_seen_at : timestamptz
  last_autograder_run_at : timestamptz
  --
  unique: assignment_id,
          platform_submission_id
  --
  FR-18, FR-29, FR-30.
  The unique key IS the idempotency
  guarantee. The autograder script
  upserts on it every run.
}

entity "submission_file" as subfile #FBE6D4 {
  * id : uuid <<PK>>
  --
  * submission_id : uuid <<FK>>
  * path : text
  content : text
  sha256 : char_64
  byte_size : integer
}

entity "test_outcome" as outcome #FBE6D4 {
  * id : uuid <<PK>>
  --
  * submission_id : uuid <<FK>>
  * grading_target_id : uuid <<FK>>
  test_name : text
  * status : text <<PASS|FAIL|ERROR|SKIP>>
  earned_score : numeric
  raw_output : text
  recorded_at : timestamptz
  --
  FR-14, FR-33
}

entity "grading_task" as task #FBE6D4 {
  * id : uuid <<PK>>
  --
  * submission_id : uuid <<FK>>
  * grading_target_id : uuid <<FK>>
  * ai_status : text <<see 06 state diagram>>
  attempt_count : integer
  claimed_at : timestamptz
  completed_at : timestamptz
  last_error : text
  --
  unique: submission_id,
          grading_target_id
  --
  **The work queue.** One row per
  submission-and-target pair. The
  autograder marks rows PENDING in
  nightly mode, and the nightly rerun
  queries for PENDING rows only.
  --
  This unique key is what stops a
  bulk "Rerun Autograder" from
  re-billing already-completed
  targets. See the note below.
}

' ---------------------------------------------------------------------
' Generated feedback
' ---------------------------------------------------------------------
entity "feedback" as fb #D6E4F0 {
  * id : uuid <<PK>>
  --
  * grading_task_id : uuid <<FK>>
  * rubric_id : uuid <<FK>>
  * provider : text
  * model_name : text
  prompt_version : text
  feedback_text : text
  suggested_score : numeric
  confidence : numeric
  is_selected : boolean
  input_tokens : integer
  output_tokens : integer
  generated_at : timestamptz
  --
  FR-15, FR-16, FR-25, FR-26.
  One row PER PROVIDER so FR-27
  comparison is a query, not a re-run.
  is_selected marks the row written
  into results.json.
}

entity "feedback_comparison" as cmp #D6E4F0 {
  * id : uuid <<PK>>
  --
  * grading_task_id : uuid <<FK>>
  agreement_score : numeric
  score_spread : numeric
  selection_reason : text
  compared_at : timestamptz
  --
  FR-27, FR-28, NFR-12
}

entity "feedback_review" as review #DCEFD9 {
  * id : uuid <<PK>>
  --
  * feedback_id : uuid <<FK>>
  reviewer : text
  instructor_rating : integer
  instructor_comment : text
  reviewed_at : timestamptz
  --
  FR-11
}

' ---------------------------------------------------------------------
' Audit
' ---------------------------------------------------------------------
entity "trigger_run" as run #EDE0F0 {
  * id : uuid <<PK>>
  --
  * trigger : text <<SCHEDULE|MANUAL>>
  started_at : timestamptz
  finished_at : timestamptz
  status : text
  assignments_rerun : integer
  tasks_pending_at_start : integer
  log_uri : text
  --
  CI-3. Records what the nightly job
  clicked, not what it graded. The
  grading itself is logged per
  grading_task.
}

' ---------------------------------------------------------------------
' Relationships
' ---------------------------------------------------------------------
course ||--o{ assignment
assignment ||--o{ target
assignment ||--o{ sub
target ||--o{ tfile
target ||--o{ rubric
target ||--o{ outcome
target ||--o{ task
sub ||--o{ subfile
sub ||--o{ outcome
sub ||--o{ task
task ||--o{ fb
task ||--o| cmp
rubric ||--o{ fb
fb ||--o{ review

note as N1 #FFF8DC
  **Why grading_task exists**
  Gradescope's "Rerun Autograder" is a bulk
  action over the whole assignment, so a nightly
  rerun re-executes the container for every
  submission, including ones already graded.

  Without a per-target completion mark, every
  night would re-bill every submission in the
  course. The autograder script must therefore
  query for ai_status = 'PENDING' and skip
  everything else, and it must claim a row
  before working on it.
end note

note as N2 #FFF8DC
  **Open decisions still outstanding**
  OQ-1  "deduction" (FR-10) is undefined. Derive
        it as a view, not a column:
        EXISTS failing test_outcome
        OR feedback.suggested_score < max_score
  OQ-2  confidence (FR-28) has a column but no
        agreed semantics.
  OQ-4  resubmissions. As drawn, every attempt
        gets its own submission row and its own
        grading_task rows, so all attempts are
        graded. is_active_attempt exists to
        support a latest-only policy if chosen.
end note

note as N3 #FFF8DC
  **Student code and FERPA**
  submission_file holds student source code and
  identifiers, and in immediate mode that code
  is sent to a third-party LLM within seconds of
  submission. Privacy, retention and consent are
  out of scope in the SRS, which is fine for a
  design doc and not for a live course. Raise
  with Pitt before real submissions land here.
end note

@enduml
