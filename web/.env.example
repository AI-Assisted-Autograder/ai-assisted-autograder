# Override for the team's existing PostgreSQL service when it is outside Compose.
DATABASE_URL=postgresql+psycopg://autograder:autograder@db:5432/autograder
INTEGRATION_API_TOKEN=local-development-token

# Signs instructor sign-in cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means a random key per start, which signs everyone out on restart.
SESSION_SECRET=
# true once the UI is behind HTTPS.
SESSION_COOKIE_SECURE=false

# Enable only after creating DB assignments and initializing their shared state.
FEEDBACK_STATE_PATH=
# FEEDBACK_STATE_PATH=/var/lib/ai-feedback/state.json
# Public HTTPS origin Gradescope uses to reach Web. Required only to issue connector packages in Web.
FEEDBACK_PUBLIC_BASE_URL=

# Set credentials only for the engines you enable. Keep this file private.
PITT_API_KEY=
# Required only to save or use a shared Pitt key entered in the Web UI.
# Keep this stable and private. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PITT_KEY_ENCRYPTION_KEY=
GEMINI_API_KEY=

# Vertex only: private host directory containing application_default_credentials.json.
# Requires impersonation ADC matching seed_feedback --service-account.
# Leave empty for Pitt/Gemini API; Compose mounts an inert /dev/null placeholder.
GOOGLE_ADC_DIR=
# GOOGLE_ADC_DIR=../ai_grading/.local-vertex/google
